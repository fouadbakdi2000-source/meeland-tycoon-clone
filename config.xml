<?xml version='1.0' encoding='utf-8'?>
<widget id="com.example.meeland" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>ميلاند تايكون</name>
  <description>لعبة تايكون حيوانات أليف مستوحاة من meeland.io - gebouwd عبر HTML/CSS/JS و Cordova</description>
  <author email="dev@example.com" href="https://github.com/fouadbakdi2000-source">Meeland Clone Dev</author>
  <content src="index.html" />
  <access origin="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <allow-intent href="tel:*" />
  <allow-intent href="sms:*" />
  <allow-intent href="mailto:*" />
  <allow-intent href="geo:*" />
  <platform name="android">
    <allow-intent href="market:*" />
    <preference name="AndroidMinSdkVersion" value="21" />
    <preference name="AndroidTargetSdkVersion" value="33" />
    <preference name="AndroidXEnabled" value="true" />
    <preference name="GradientDrawable" value="true" />
  </platform>
  <platform name="ios">
    <allow-intent href="itms:*" />
    <allow-intent href="itms-apps:*" />
  </platform>
</widget>